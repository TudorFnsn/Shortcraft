# ─────────────────────────────────────────────────────────────────────────────
# Shortcraft environment.
# Copy to `.env.local` and fill in as you wire each integration.
# With MOCK_PROVIDERS=true (the default) the app runs end-to-end with NONE of the
# provider/Stripe/Supabase keys set — build and test everything first, wire later.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Master switch. true => deterministic mock providers, no network, no keys.
MOCK_PROVIDERS=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (auth + db + storage) ───────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (only needed when MOCK_PROVIDERS=false) ──────────────────────
# ANTHROPIC_API_KEY=      # script writer
# ANTHROPIC_WORKSPACE_ID= # only if the key above isn't scoped to a workspace
# FAL_KEY=                # images (FLUX on fal.ai) + premium video models
# FAL_VIDEO_MODEL=        # premium image-to-video model (default fal-ai/kling-video/v2.5-turbo/pro/image-to-video)
# ELEVENLABS_API_KEY=     # voiceover + word timings
# FFMPEG_PATH=            # in-house renderer binary (default: ffmpeg on PATH)

# ── Stripe (billing step) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Background jobs ───────────────────────────────────────────────────────────
# CRON_SECRET=            # Vercel Cron bearer token for /api/cron/advance-jobs (not needed locally)
