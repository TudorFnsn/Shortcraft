# ─────────────────────────────────────────────────────────────────────────────
# Shortcraft environment.
# Copy to `.env.local` and fill in as you wire each integration.
# With MOCK_PROVIDERS=true (the default) the app runs end-to-end with NONE of the
# provider/Stripe/Supabase keys set — build and test everything first, wire later.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Master switch. true => deterministic mock providers, no network, no keys.
MOCK_PROVIDERS=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (auth + db + storage) ───────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (only needed when MOCK_PROVIDERS=false) ──────────────────────
# ANTHROPIC_API_KEY=      # script writer
# FAL_KEY=                # image + video models
# ELEVENLABS_API_KEY=     # voiceover + word timings
# RENDER_API_KEY=         # final stitch + subtitle burn (Shotstack/Creatomate/fal)

# ── Stripe (billing step) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
